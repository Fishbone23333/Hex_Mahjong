NODE_ENV=production
HOST=127.0.0.1
PORT=3000
HEX_DB_PATH=/var/lib/hex-mahjong/hex-mahjong.sqlite
HEX_BASE_PATH=/hex-mahjong/
HEX_COOKIE_NAME=hex_mahjong_session
# Replace with the public HTTPS origin used by your deployment.
ALLOWED_ORIGINS=https://example.com
HEX_MAX_PRIVATE_CARDS=200
HEX_MAX_POOLS=30
HEX_MAX_USERS=5000
HEX_MAX_SESSIONS=10
HEX_REGISTRATION_ENABLED=true
SETTLEMENT_TRIGGER_RATE=0.03
SOUL_TRANSFER_TRIGGER_RATE=0.03

# SMTP 配置：正式凭据只填写到服务器 /etc/hex-mahjong.env。
# 全部填写后开放邮箱绑定/找回密码；注册仍不要求绑定邮箱。
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-qq-number@qq.com
# SMTP_PASS=your-smtp-authorization-code
# MAIL_FROM=your-qq-number@qq.com
# MAIL_PUBLIC_BASE_URL=https://example.com/hex-mahjong/
